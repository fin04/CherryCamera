<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.epriest.cherryCamera.MainActivity">

    <fragment
        android:id="@+id/main_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        class = "com.epriest.cherryCamera.main.fragment.FragmentMain"/>

    <fragment
        android:id="@+id/upper_fragment"
        class="com.epriest.cherryCamera.main.fragment.FragmentUpper"
        android:layout_width="match_parent"
        android:layout_height="@dimen/MENUBUTTON_SIZE"
        android:layout_toRightOf="@id/left_fragment" />

    <fragment
        android:id="@+id/bottom_fragment"
        class="com.epriest.cherryCamera.main.fragment.FragmentBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/BANNER_HEIGHT"
        android:layout_alignParentBottom="true"
        android:layout_toRightOf="@id/left_fragment" />

    <fragment
        android:id="@+id/left_fragment"
        class="com.epriest.cherryCamera.main.fragment.FragmentLeft"
        android:layout_width="@dimen/OPTION_MENU_WIDTH"
        android:layout_height="match_parent" />

</RelativeLayout>
